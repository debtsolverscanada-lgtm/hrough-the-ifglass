    "eyes": "wide",
    "beyond": "hall",
    "open": 0,
    "openTo": 1
   },
   "text": "The doors opened on my hallway. Same red carpet. Same light that's been flickering since the day I moved in.",
   "pause": 0.25
  },
  {
   "scene": "corridor",
   "p": {
    "flicker": true,
