    "clock": "03:07:44",
    "label": "Floor 13 - night 2",
    "rec": false,
    "spike": 0.9,
    "shake": 0.2
   },
   "text": "She never moves. The whole time, she never moves. I'm the one who keeps getting closer.",
   "pause": 0.9
  },
  {
   "scene": "text",
   "p": {
    "text": "I WAS THE ONE|GETTING CLOSER.",
    "color": "#ff2a2a"
   },
   "text": "Except she hadn't been the one getting closer. I had.",
