      960,
      760
     ],
     "z": 3.0
    }
   },
   "text": "Same door at the end. But the brass number on it said thirteen oh seven.",
   "pause": 0.25
  },
  {
   "scene": "corridor",
   "p": {
    "ajar": true,
    "num": "1307",
    "floor": 13
   },
   "text": "And it was open. Warm light. Garlic and onions. Somebody was cooking.",
   "pause": 0.25,
   "sfx": [
    [
     "creak",
     0.4
    ]
   ]
  },
  {
   "scene": "kitchen",
   "p": {
    "cook": true,
    "lights": true,
    "focus": 820
   },
   "text": "I know. I should have stayed in the elevator. Everyone yells that at the screen. But it smelled like my kitchen. It looked like my kitchen.",
   "pause": 0.25
  },
  {
   "scene": "kitchen",
   "p": {
